class ContaBancaria {
  init(titular, saldoInicial) {
    this.titular = titular;
    this.saldo = saldoInicial;
  }

  depositar(valor) {
    this.saldo = this.saldo + valor;
  }

  sacar(valor) {
    if (valor > this.saldo) {
      print "Saldo insuficiente!";
      return;
    }
    this.saldo = this.saldo - valor;
  }

  mostrarSaldo() {
    print this.titular;
    print this.saldo;
  }
}

// Uso da classe
var conta = ContaBancaria("João", 100);

print "==== SALDO INICIAL ====";
conta.mostrarSaldo();
print "==== DEPOSITAR 50R$ ====";
conta.depositar(50);
conta.mostrarSaldo();
print "==== SACAR 200R$ ====";
conta.sacar(200);
print "==== SACAR 80R$ ====";
conta.sacar(80);
conta.mostrarSaldo();
